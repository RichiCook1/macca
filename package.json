{
  "name": "macca",
  "version": "0.1.0",
  "private": true,
  "description": "MACCA — Museo d'Arte Contemporanea a Cielo Aperto. Map-first digital museum for contemporary art dispersed across Peccioli.",
  "scripts": {
    "content": "node scripts/build-content-manifest.mjs",
    "demo:images": "node scripts/gen-demo-images.mjs",
    "demo:clear": "node scripts/gen-demo-images.mjs --clear",
    "predev": "node scripts/build-content-manifest.mjs && node scripts/build-og-images.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-content-manifest.mjs && node scripts/build-og-images.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "og": "node scripts/build-og-images.mjs"
  },
  "dependencies": {
    "next": "15.5.22",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/google.maps": "^3.65.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.49.1",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
